# Restaurant OS — environment template
# Copy to .env.local and fill. Never commit real values.

# Database
NEON_DATABASE_URL=                 # WebSocket pooled — all writes
NEON_DATABASE_URL_HTTP=            # HTTP driver — RSC reads only

# Auth
AUTH_SECRET=
AUTH_URL=
ENCRYPTION_KEY=
OTP_PEPPER=                        # storefront customer OTP login (§13.3) — unrelated to staff auth

# Storage

# Email
RESEND_API_KEY=
RESEND_FROM_TRANSACTIONAL=
RESEND_FROM_OTP=                   # dedicated subdomain, §13.3
CRON_SECRET=                       # Vercel Cron bearer token for the daily owner emails (ADR 0029)

# Realtime
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# URLs
NEXT_PUBLIC_STOREFRONT_URL=
NEXT_PUBLIC_POS_URL=
