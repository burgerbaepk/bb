# The dependency graph mixes ESLint 10, TypeScript 6, and Next 16. Several
# packages declare peer ranges that predate one or another of these. Peer
# resolution is asserted by CI typecheck and lint, not by install.
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest

# pnpm 10+ prompts before purging node_modules; there is no TTY in CI or here.
confirm-modules-purge=false
