{
  "name": "@natech/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, clients, seeds",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx seeds/index.ts",
    "db:consolidate-menu": "tsx seeds/consolidate-menu.ts",
    "db:owner": "tsx seeds/owner.ts"
  },
  "devDependencies": {
    "@natech/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "drizzle-kit": "0.31.10",
    "@types/ws": "8.18.1",
    "dotenv": "17.4.2",
    "tsx": "4.23.12"
  },
  "dependencies": {
    "@natech/auth": "workspace:*",
    "@natech/contracts": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "ws": "8.21.3"
  }
}
