{
  "name": "@natech/print-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local ESC/POS agent on the till (BUILD-PLAN §12, §15.3)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./escpos": "./src/escpos.ts",
    "./raster": "./src/raster.ts"
  },
  "scripts": {
