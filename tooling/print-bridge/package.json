    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@upstash/redis": "1.38.2",
    "mehr": "2.0.1",
    "satori": "0.33.4"
  },
  "devDependencies": {
    "@natech/config": "workspace:*",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
